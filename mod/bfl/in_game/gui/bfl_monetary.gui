types BFLMonetaryTypes { type bfl_money_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/monetary_notes.dds" } }
        blockoverride "title_text" { text = "bfl_money_title" }
        blockoverride "concept_link" { text = "bfl_money_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { size = { 100% 100% } margin = { 10 2 } spacing = 8
             text_single = { text = "bfl_ui_52d246b314893f59" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_notes_outstanding').GetValue|2] / [Country.MakeScope.GetVariable('bfl_cash_committed').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { size = { 100% 100% } margin = { 10 2 } spacing = 8
             text_single = { text = "bfl_ui_54e607aa1c7bbb0c" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_money_assets').GetValue|2]@gold! / [Country.MakeScope.GetVariable('bfl_money_confidence').GetValue|0]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { size = { 100% 100% } margin = { 10 2 } spacing = 8
             text_single = { text = "bfl_ui_ecc2db28f6c3d1e8" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_money_rate').GetValue|%1] / [Country.MakeScope.GetVariable('bfl_clearing_failed').GetValue|0]" autoresize = yes align = right|nobaseline } } }TooltipListScrollArea = {
        blockoverride "block_scrollarea" {  maximumsize = { 420 240 } }
        blockoverride "scrollarea_content" { TooltipContentSection = {
