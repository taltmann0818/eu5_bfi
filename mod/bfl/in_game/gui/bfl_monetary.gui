        icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/monetary_clearing.dds" }
        } }button_regular = { name = "bfl_request_public_support_button" size = { 36 36 }
        datacontext = "[GetPlayer]"
        enabled = "[GetScriptedGui('bfl_request_public_support_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_request_public_support_tip"
        scripted_action_tooltip = { click_type = left click_mode = single
            action_name = "bfl_request_public_support_command" actor = "[GetPlayer]" }
        icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/monetary_clearing.dds" }
        }
            hbox = { layoutpolicy_horizontal = expanding spacing = 5
                icon = { size = { 28 28 } texture = "gfx/interface/icons/bfl/bank_branch.dds" }
                text_multi = { text = "bfl_branch_required" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12 } }
            text_multi = { text = "bfl_money_help" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12 } } } }
