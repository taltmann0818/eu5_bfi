        icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/monetary_clearing.dds" }
        } }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { name = "bfl_transfer_bank_bill_button" size = { 36 36 }
        datacontext = "[GetPlayer]"
        enabled = "[GetScriptedGui('bfl_transfer_bank_bill_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_transfer_bank_bill_tip"
        scripted_action_tooltip = { click_type = left click_mode = single
