            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_note_08_face').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } } } } }TooltipTextBlock = { visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_notes_outstanding').GetValue,'(CFixedPoint)0')]"
        blockoverride "text" { text = "bfl_money_empty" } }TooltipFlavorTextBlock = { blockoverride "text" { text = "bfl_money_terms" } } } }
    } type bfl_monetary_contents = vbox { layoutpolicy_horizontal = expanding spacing = 4 widget = { size = { -1 76 } layoutpolicy_horizontal = expanding using = bg_card_header_01
        icon = { position = { 8 12 } size = { 46 46 } texture = "gfx/interface/icons/bfl/monetary_notes.dds" }
        widget = { position = { 60 4 } size = { 300 66 } tooltipwidget = { bfl_money_tooltip = { } }
            text_single = { text = "bfl_money_title" autoresize = yes fontsize = 15 }
            text_single = { position = { 0 23 } raw_text = "[Country.MakeScope.GetVariable('bfl_notes_outstanding').GetValue|2]@gold! · [Country.MakeScope.GetVariable('bfl_money_rate').GetValue|%1]" autoresize = yes fontsize = 21 }
            text_single = { position = { 0 50 } text = "bfl_money_hint" autoresize = yes fontsize = 11 } }
        button_regular = { parentanchor = top|right position = { -8 10 } size = { 62 56 } tooltip = "bfl_money_settings_tip"
            onclick = "[GetScriptedGui('bfl_money_settings').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            icon = { parentanchor = top|hcenter position = { 0 1 } size = { 38 38 } texture = "gfx/interface/icons/bfl/monetary_clearing.dds" }
            text_single = { parentanchor = bottom|hcenter position = { 0 -2 } text = "bfl_money_settings" autoresize = yes fontsize = 11 } } }
        vbox = { layoutpolicy_horizontal = expanding spacing = 3 ignoreinvisible = yes
            visible = "[GetScriptedGui('bfl_money_policy_view').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
            text_single = { text = "bfl_ui_77203b33c026b544" autoresize = yes fontsize = 13 }
            text_single = { text = "bfl_ui_07a8fd504f9665d3" autoresize = yes fontsize = 13
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_money_accept').GetValue,'(CFixedPoint)1')]" }
            text_single = { text = "bfl_ui_36229de4218b517d" autoresize = yes fontsize = 13
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_money_accept').GetValue,'(CFixedPoint)0')]" }
            button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_accept"
            enabled = "[GetScriptedGui('bfl_money_accept').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_accept').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_accept_tip" }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_lending_rate"
            enabled = "[GetScriptedGui('bfl_money_lending_rate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_lending_rate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_lending_rate_tip" } button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_policy_rate"
            enabled = "[GetScriptedGui('bfl_money_policy_rate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_policy_rate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_policy_rate_tip" } }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_authorize"
            enabled = "[GetScriptedGui('bfl_money_authorize').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_authorize').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_authorize_tip" } button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_revoke"
            enabled = "[GetScriptedGui('bfl_money_revoke').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_revoke').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_revoke_tip" } }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_notes"
            enabled = "[GetScriptedGui('bfl_money_notes').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_notes').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_notes_tip" } button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_redeem"
            enabled = "[GetScriptedGui('bfl_money_redeem').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_redeem').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_redeem_tip" } }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_clear_open"
            enabled = "[GetScriptedGui('bfl_money_clear_open').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_clear_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_clear_open_tip" } button_regular = { name = "bfl_join_clearing_group_button" size = { 36 36 }
        datacontext = "[GetPlayer]"
        enabled = "[GetScriptedGui('bfl_join_clearing_group_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_join_clearing_group_tip"
        scripted_action_tooltip = { click_type = left click_mode = single
            action_name = "bfl_join_clearing_group_command" actor = "[GetPlayer]" }
        icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/monetary_clearing.dds" }
        } }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_clear"
            enabled = "[GetScriptedGui('bfl_money_clear').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_clear_tip" } button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_leave"
            enabled = "[GetScriptedGui('bfl_money_leave').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_leave').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_leave_tip" } }hbox = { layoutpolicy_horizontal = expanding spacing = 5 button_regular = { size = { -1 28 } layoutpolicy_horizontal = expanding text = "bfl_money_repay"
            enabled = "[GetScriptedGui('bfl_money_repay').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_money_repay').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_money_repay_tip" } button_regular = { name = "bfl_request_discount_button" size = { 36 36 }
        datacontext = "[GetPlayer]"
        enabled = "[GetScriptedGui('bfl_request_discount_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "bfl_request_discount_tip"
        scripted_action_tooltip = { click_type = left click_mode = single
