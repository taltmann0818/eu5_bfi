            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_note_04_face').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = { visible = "[GreaterThan_CFixedPoint(Country.MakeScope.GetVariable('bfl_note_05_face').GetValue,'(CFixedPoint)0')]" size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { size = { 100% 100% } margin = { 10 2 } spacing = 8
