types BFLFinanceTypes {
        type bfl_statement = widget { layoutpolicy_horizontal = expanding
            vbox = { layoutpolicy_horizontal = expanding spacing = 3 text_single = { raw_text = "[Country.GetName]" autoresize = yes }
text_single = { raw_text = "Specialization (1 Merchant / 2 Overseas): [Country.MakeScope.GetVariable('bfl_profile').GetValue|2]" autoresize = yes }
text_single = { raw_text = "Operating state (0–5): [Country.MakeScope.GetVariable('bfl_state').GetValue|2]" autoresize = yes }
text_single = { raw_text = "Last processed month: [Country.MakeScope.GetVariable('bfl_last_period').GetValue|2]" autoresize = yes }
text_single = { raw_text = "Royalty paid: [Country.MakeScope.GetVariable('bfl_royalty_paid').GetValue|2]" autoresize = yes }
text_single = { raw_text = "Royalty assessment deferred: [Country.MakeScope.GetVariable('bfl_royalty_deferred').GetValue|2]" autoresize = yes }
text_single = { raw_text = "State dividends paid: [Country.MakeScope.GetVariable('bfl_dividend_paid').GetValue|2]" autoresize = yes }
text_single = { raw_text = "State equity units: [Country.MakeScope.GetVariable('bfl_state_units').GetValue|2]" autoresize = yes }
text_single = { raw_text = "Total equity units: [Country.MakeScope.GetVariable('bfl_total_units').GetValue|2]" autoresize = yes }
text_single = { raw_text = "Cash: [Country.GetCurrencyBalance('gold')|2]" autoresize = yes }
text_single = { raw_text = "Liabilities: [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_liabilities')|2]" autoresize = yes }
text_single = { raw_text = "Equity: [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_equity')|2]" autoresize = yes }
text_single = { raw_text = "Protected cash: [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_protected_cash')|2]" autoresize = yes }
text_single = { raw_text = "Free cash: [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_free_cash')|2]" autoresize = yes }
 }
        }
        type bfl_finance_section = widget {
            layoutpolicy_horizontal = expanding
            vbox = { spacing = 5 layoutpolicy_horizontal = expanding
                button_regular = { size = { 100% 36 } text = "bfl_finance_title"
                    onclick = "[LateralView.Vars.Toggle('bfl_finance_expanded')]"
                }
                vbox = { layoutpolicy_horizontal = expanding spacing = 5
                    visible = "[LateralView.Vars.Exists('bfl_finance_expanded')]"
                    text_multi = { text = "bfl_no_bank" autoresize = yes layoutpolicy_horizontal = expanding
                        visible = "[Not(GetScriptedGui('bfl_permission_demand_deposit').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                    }
                    scrollarea = { size = { 100% 320 }
                        visible = "[GetScriptedGui('bfl_permission_demand_deposit').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        scrollwidget = {
                            vbox = { layoutpolicy_horizontal = expanding spacing = 4 button_regular = { text = "bfl_overview" size = { 100% 30 } onclick = "[LateralView.Vars.Toggle('bfl_overview_expanded')]" }
        vbox = { spacing = 4 layoutpolicy_horizontal = expanding visible = "[LateralView.Vars.Exists('bfl_overview_expanded')]"
        bfl_statement = { datacontext = "[GetPlayer]"
            visible = "[GetScriptedGui('bfl_independent_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
        bfl_statement = { datacontext = "[GetPlayer.MakeScope.GetVariable('bfl_bank').GetCountry]"
            visible = "[GetScriptedGui('bfl_charter_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
    text_multi = { text = "bfl_accounts_explanation" autoresize = yes layoutpolicy_horizontal = expanding }
button_regular = { size = { 100% 28 } text = "bfl_select_profile"
            enabled = "[GetScriptedGui('bfl_select_profile').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_select_profile').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
 }
button_regular = { text = "bfl_deposits" size = { 100% 30 } onclick = "[LateralView.Vars.Toggle('bfl_deposits_expanded')]" }
        vbox = { spacing = 4 layoutpolicy_horizontal = expanding visible = "[LateralView.Vars.Exists('bfl_deposits_expanded')]" text_multi = { text = "bfl_deposit_explanation" autoresize = yes layoutpolicy_horizontal = expanding }
button_regular = { size = { 100% 28 } text = "bfl_deposit_1"
            enabled = "[GetScriptedGui('bfl_deposit_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_deposit_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
button_regular = { size = { 100% 28 } text = "bfl_deposit_2"
