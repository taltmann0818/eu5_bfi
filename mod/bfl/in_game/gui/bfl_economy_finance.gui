types BFLFinanceTypes {
        type bfl_income_dividends = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding tooltip = "bfl_balance_paid_tip"
                blockoverride "icon_texture" { texture = "gfx/interface/icons/bfl/dividend.dds" }
                blockoverride "label" { text = "bfl_bank_dividends" }
                blockoverride "income_text" { raw_text = "[Country.MakeScope.GetVariable('bfl_state_dividend_paid').GetValue|2+=]@income!" } }type bfl_income_royalties = adjustable_budget_card {
                layoutpolicy_horizontal = expanding size = { -1 55 }
                blockoverride "top_widget" { hbox = { margin = { 5 0 } spacing = 5
                    icon = { texture = "gfx/interface/icons/bfl/royalty.dds" size = { 31 31 } }
                    text_single = { using = layoutpolicy_expanding maximumsize = { 175 -1 } autoresize = no align = left|nobaseline text = "bfl_bank_royalties" }
                    text_single = { autoresize = yes align = right|nobaseline raw_text = "[Country.MakeScope.GetVariable('bfl_royalty_paid').GetValue|2+=]@income!" } } }
                blockoverride "bottom_widget" { hbox = { margin = { 5 0 }
                    hbox = { size = { 145 20 } layoutpolicy_horizontal = fixed ranged_slider = {
        name = "bfl_royalty_slider" size = { 110 10 }
        direction = horizontal allow_outside = yes
        value = "[FixedPointToFloat(Country.MakeScope.GetVariable('bfl_royalty_tier').GetValue)]"
        min = 0 max = 4 mincap = 0 maxcap = 4 step = 1 wheelstep = 1
        enabled = "[GetScriptedGui('bfl_charter_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        tooltip = "bfl_royalty_tip"
        track = { using = economy_slider_track }
        track_range = { EconomySlider_TrackRange = { name = "bfl_royalty_range" } }
        track_highlight = { EconomySlider_TrackHighlight = { name = "bfl_royalty_fill" } }
        slider = { EconomySlider_Slider = { name = "bfl_royalty_thumb" } }
        dec_button = { using = economy_slider_dec_button }
        inc_button = { using = economy_slider_inc_button }
        onchangefinish = "[PdxGuiWidget.TriggerAnimation('bfl_commit_royalty')]"
        state = { name = bfl_commit_royalty duration = 0.05 on_finish = "[GetScriptedGui('bfl_apply_royalty_slider').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bfl_royalty_input', MakeScopeValue(Select_CFixedPoint(LessThan_float(Divide_float(PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_fill').GetSizeX, Max_float('(float)1', PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_range').GetSizeX)), '(float)0.125'), '(CFixedPoint)0', Select_CFixedPoint(LessThan_float(Divide_float(PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_fill').GetSizeX, Max_float('(float)1', PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_range').GetSizeX)), '(float)0.375'), '(CFixedPoint)1', Select_CFixedPoint(LessThan_float(Divide_float(PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_fill').GetSizeX, Max_float('(float)1', PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_range').GetSizeX)), '(float)0.625'), '(CFixedPoint)2', Select_CFixedPoint(LessThan_float(Divide_float(PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_fill').GetSizeX, Max_float('(float)1', PdxGuiWidget.AccessParent.FindChild('bfl_royalty_slider').FindChild('bfl_royalty_range').GetSizeX)), '(float)0.875'), '(CFixedPoint)3', '(CFixedPoint)4')))))).End)]" }
    }
                        icon = { size = { 20 20 } texture_density = 2 texture = "gfx/interface/buttons/checkbox_auto.dds" frame_grid = { 2 1 } frame = 1 tooltip = "bfl_royalty_tip"
                            background = { texture = "gfx/interface/buttons/checkbox_auto_bg.dds" texture_density = 2 using = color_dark_blue } } expand = { } }
                    hbox = { size = { 39 20 } layoutpolicy_horizontal = fixed
                        text_single = { size = { 25 20 }

            autoresize = no align = right|nobaseline using = Font_Size_Very_Small
            raw_text = "[GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction|R0%]" tooltip = "bfl_royalty_tip"
            visible = "[LessThan_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction, '(CFixedPoint)0.5')]" }text_single = { size = { 25 20 }

            autoresize = no align = right|nobaseline using = Font_Size_Very_Small
            raw_text = "[GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction|G0%]" tooltip = "bfl_royalty_tip"
            visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction, '(CFixedPoint)0.5')]" } icon = { size = { 14 14 } texture_density = 2
            texture = "gfx/interface/icons/flat_icons/sad.dds" visible = "[LessThanOrEqualTo_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction, '(CFixedPoint)0.25')]" }icon = { size = { 14 14 } texture_density = 2
            texture = "gfx/interface/icons/flat_icons/neutral.dds" visible = "[BetweenInclusiveOfMax_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction, '(CFixedPoint)0.25', '(CFixedPoint)0.5')]" }icon = { size = { 14 14 } texture_density = 2
            texture = "gfx/interface/icons/flat_icons/happy.dds" visible = "[GreaterThan_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetSatisfaction, '(CFixedPoint)0.5')]" } }
                    widget = { size = { 14 14 } icon = { parentanchor = center position = { -1 0 } allow_outside = yes size = { 20 20 } texture = "gfx/interface/buttons/flats/button_simple.dds"
                        modify_texture = { using = color_bone_texture blend_mode = normal } } }
                    hbox = { using = layoutpolicy_expanding spacing = 1
                        text_single = { size = { -1 20 }
            layoutpolicy_horizontal = expanding
            autoresize = no align = right|nobaseline using = Font_Size_Very_Small
            raw_text = "[GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetTargetSatisfaction|R2%]" tooltip = "bfl_royalty_tip"
            visible = "[LessThan_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetTargetSatisfaction, '(CFixedPoint)0.5')]" }text_single = { size = { -1 20 }
            layoutpolicy_horizontal = expanding
            autoresize = no align = right|nobaseline using = Font_Size_Very_Small
            raw_text = "[GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetTargetSatisfaction|G2%]" tooltip = "bfl_royalty_tip"
            visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetTargetSatisfaction, '(CFixedPoint)0.5')]" } icon = { size = { 14 14 } texture_density = 2
            texture = "gfx/interface/icons/flat_icons/sad.dds" visible = "[LessThanOrEqualTo_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetTargetSatisfaction, '(CFixedPoint)0.25')]" }icon = { size = { 14 14 } texture_density = 2
            texture = "gfx/interface/icons/flat_icons/neutral.dds" visible = "[BetweenInclusiveOfMax_CFixedPoint(GetPlayer.GetGovernment.GetEstateFromKey('burghers_estate').GetTargetSatisfaction, '(CFixedPoint)0.25', '(CFixedPoint)0.5')]" }icon = { size = { 14 14 } texture_density = 2
