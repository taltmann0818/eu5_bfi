types BFLFinanceTypes {
        type bfl_company_overview_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/companies.dds" } }
        blockoverride "title_text" { text = "bfl_company_overview_title" }
        blockoverride "concept_link" { text = "bfl_company_overview_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Cash" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.GetFixedPointCurrencyValue('gold')|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Trade receipts" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_trade_receipts').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Native net budget" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_native_net').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Earned profit" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_verified_profit').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Owner dividend" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_dividend').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Cash buffer" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_buffer').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Reinvestment reserve" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_reinvestment').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Facilities" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_facility_count').GetValue|2]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Trade routes" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_company_route_count').GetValue|2]" autoresize = yes align = right|nobaseline } } }TooltipFlavorTextBlock = { blockoverride "text" { text = "bfl_company_overview_note" } } } }
    }type bfl_company_controls = vbox { ignoreinvisible = yes
        layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed spacing = 4
        hbox = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed size = { -1 40 } using = bg_card_header_01 spacing = 6
        text_single = { text = "bfl_company_panel" autoresize = yes } expand = { } button_regular = { name = "bfl_company_fund_icon" size = { 36 36 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
        datacontext = "[GetGenericAction('bfl_company_fund')]" tooltip = "bfl_company_fund_tip"
        enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
        scripted_action_tooltip = { click_type = left click_mode = single action_name = "bfl_company_fund" actor = "[GetPlayer]" }
        icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/subscribe.dds" } }button_regular = { name = "bfl_company_list_equity_icon" size = { 36 36 } layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed
        datacontext = "[GetGenericAction('bfl_company_list_equity')]" tooltip = "bfl_company_list_equity_tip"
        enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
        scripted_action_tooltip = { click_type = left click_mode = single action_name = "bfl_company_list_equity" actor = "[GetPlayer]" }
        icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/share_transfer.dds" } } }
        text_multi = { text = "bfl_companies_empty" autoresize = yes layoutpolicy_horizontal = expanding
            visible = "[Not(GetScriptedGui('bfl_company_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
        flowcontainer = { wrap_count = 1 ignoreinvisible = yes layoutpolicy_horizontal = expanding
            datamodel = "[GetPlayer.GetDiplomacy.GetSubjects]"
            item = { widget = { size = { 510 64 } layoutpolicy_horizontal = expanding using = bg_card_header_01
                visible = "[GetScriptedGui('bfl_company_row').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
                tooltipwidget = { bfl_company_overview_tooltip = { } }
                country_flag_small = { position = { 8 10 } }
                text_single = { position = { 42 8 } size = { 300 24 } raw_text = "[Country.GetName]" elide = right fontsize = 16 }
                text_single = { position = { 42 34 } raw_text = "[Country.GetFixedPointCurrencyValue('gold')|2]@gold!" autoresize = yes }
                text_single = { position = { 300 34 } raw_text = "[Country.MakeScope.GetVariable('bfl_company_dividend').GetValue|2]@income!" autoresize = yes }
            } } }
    }
        type bfl_income_dividends = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding tooltipwidget = { bfl_balance_dividend_tooltip = { } } tooltip = "bfl_balance_paid_tip"
            blockoverride "icon_texture" { texture = "gfx/interface/icons/bfl/dividend.dds" }
            blockoverride "label" { text = "bfl_bank_dividends" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_bank_dividend_annual')|2+=]@income!" } }type bfl_income_interest = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding  tooltip = "bfl_deposit_income_tip"
            blockoverride "icon_texture" { texture = "gfx/interface/icons/bfl/deposit.dds" }
            blockoverride "label" { text = "bfl_deposit_interest" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_deposit_income_display')|2+=]@income!" } }type bfl_income_facility = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding  tooltip = "bfl_facility_tip"
            blockoverride "icon_texture" { texture = "[GetConceptTexture('government_bond')]" }
            blockoverride "label" { text = "bfl_debt_facility" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_bond_financing_display')|2+=]@income!" } }type bfl_income_bond_coupons = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding  tooltip = "bfl_bond_income_tip"
            blockoverride "icon_texture" { texture = "[GetConceptTexture('government_bond')]" }
            blockoverride "label" { text = "bfl_bond_coupons" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_bond_income_display')|2+=]@income!" } }
        type bfl_sovereign_debt_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/debt.dds" } }
        blockoverride "title_text" { text = "bfl_sovereign_debt_heading" }
        blockoverride "concept_link" { text = "bfl_sovereign_accounts_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 icon_pie = {
            visible = "[Not(IsDataModelEmpty(CreditLateralView.GetLoansTakenMerged))]"
            blockoverride "PieSize" { size = { 80 80 } }
            blockoverride "scrollarea_pie_size" { using = layoutpolicy_expanding size = { 300 -1 } maximumsize = { 300 250 } }
            blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
            blockoverride "Icon" { texture = "[GetConceptTexture('borrower')]" }
            blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
            blockoverride "SliceColor" { color = "[LoanEntry.GetColor]" }
            blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetShortNameAsBorrower]" }
            blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
            blockoverride "color" { color = "[LoanEntry.GetColor]" }
            blockoverride "leftside_info" { text = "[LoanEntry.GetShortNameAsBorrower]" }
            blockoverride "rightside_info" { raw_text = "[LoanEntry.GetAmountWithRemainingInterest]" } }
            TooltipTextBlock = { visible = "[IsDataModelEmpty(CreditLateralView.GetLoansTakenMerged)]"
                blockoverride "text" { text = "NO_LOANS_TAKEN" } } } }
    }type bfl_sovereign_receivables_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/debt.dds" } }
        blockoverride "title_text" { text = "bfl_sovereign_receivables_heading" }
        blockoverride "concept_link" { text = "bfl_sovereign_accounts_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 icon_pie = {
            visible = "[Not(IsDataModelEmpty(CreditLateralView.GetLoansGivenMerged))]"
            blockoverride "PieSize" { size = { 80 80 } }
            blockoverride "scrollarea_pie_size" { using = layoutpolicy_expanding size = { 300 -1 } maximumsize = { 300 250 } }
            blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
            blockoverride "Icon" { texture = "[GetConceptTexture('lender')]" }
            blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
            blockoverride "SliceColor" { color = "[LoanEntry.GetBorrowerColor]" }
            blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
            blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
            blockoverride "color" { color = "[LoanEntry.GetBorrowerColor]" }
            blockoverride "leftside_info" { text = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
            blockoverride "rightside_info" { raw_text = "[LoanEntry.GetAmount|2]@gold!" } }
            TooltipTextBlock = { visible = "[IsDataModelEmpty(CreditLateralView.GetLoansGivenMerged)]"
                blockoverride "text" { text = "NO_LOANS_GIVEN" } } } }
    }
