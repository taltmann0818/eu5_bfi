            onclick = "[GetScriptedGui('bfl_rate_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
hbox = { spacing = 5
            icon = { size = { 18 18 } texture = "gfx/interface/icons/bfl/lock.dds" visible = "[Not(GetScriptedGui('bfl_permission_term_deposit').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
            text_single = { text = "bfl_term_deposit" autoresize = yes }
        }
 }
