            onclick = "[GetScriptedGui('bfl_rate_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
button_regular = { size = { 100% 28 } text = "bfl_rate_1"
            enabled = "[GetScriptedGui('bfl_rate_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
