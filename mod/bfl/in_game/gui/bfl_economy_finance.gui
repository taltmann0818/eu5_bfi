types BFLFinanceTypes {
        type bfl_company_controls = scrollarea {
        visible = "[GetScriptedGui('bfl_company_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        size = { -1 180 } layoutpolicy_horizontal = expanding scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = Scrollbar_Vertical }
        scrollwidget = { vbox = { layoutpolicy_horizontal = expanding spacing = 5 margin = { 8 5 }
            tooltip = "bfl_company_panel_tip"
            text_single = { text = "bfl_company_panel" autoresize = yes }
            vbox = { layoutpolicy_horizontal = expanding
                visible = "[GetScriptedGui('bfl_company_selected_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                datacontext = "[GetPlayer.MakeScope.GetVariable('bfl_selected_company').GetCountry]"
                text_single = { raw_text = "[Country.GetName]" autoresize = yes }
                text_multi = { text = "bfl_company_statement" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12 }
            }
            button_regular = { name = "bfl_company_select_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_select" datacontext = "[GetGenericAction('bfl_company_select')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_select_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_select" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_retain_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_retain" datacontext = "[GetGenericAction('bfl_company_retain')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_retain_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_retain" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_trade_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_trade" datacontext = "[GetGenericAction('bfl_company_trade')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_trade_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_trade" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_explore_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_explore" datacontext = "[GetGenericAction('bfl_company_explore')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_explore_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_explore" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_fund_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_fund" datacontext = "[GetGenericAction('bfl_company_fund')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_fund_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_fund" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_crew_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_crew" datacontext = "[GetGenericAction('bfl_company_crew')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_crew_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_crew" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_route_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_route" datacontext = "[GetGenericAction('bfl_company_route')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_route_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_route" actor = "[GetPlayer]" }
        }button_regular = { name = "bfl_company_expedition_button" size = { -1 32 }
            layoutpolicy_horizontal = expanding text = "bfl_company_expedition" datacontext = "[GetGenericAction('bfl_company_expedition')]"
            enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_company_expedition_tip"
            scripted_action_tooltip = { click_type = left click_mode = single
                action_name = "bfl_company_expedition" actor = "[GetPlayer]" }
        }
            text_multi = { text = "bfl_company_native_channels" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 11 }
        } }
    }
        type bfl_income_dividends = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding tooltip = "bfl_balance_paid_tip"
            blockoverride "icon_texture" { texture = "gfx/interface/icons/bfl/dividend.dds" }
            blockoverride "label" { text = "bfl_bank_dividends" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_share_income_display')|2+=]@income!" } }type bfl_income_interest = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding tooltip = "bfl_deposit_income_tip"
            blockoverride "icon_texture" { texture = "gfx/interface/icons/bfl/deposit.dds" }
            blockoverride "label" { text = "bfl_deposit_interest" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_deposit_income_display')|2+=]@income!" } }type bfl_income_facility = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding tooltip = "bfl_facility_tip"
            blockoverride "icon_texture" { texture = "[GetConceptTexture('government_bond')]" }
            blockoverride "label" { text = "bfl_debt_facility" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_custom_bond_financing_received')|2+=]@income!" } }type bfl_income_bond_coupons = budget_card { size = { -1 30 } layoutpolicy_horizontal = expanding tooltip = "bfl_bond_income_tip"
            blockoverride "icon_texture" { texture = "[GetConceptTexture('government_bond')]" }
            blockoverride "label" { text = "bfl_bond_coupons" }
            blockoverride "income_text" { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_bond_income_display')|2+=]@income!" } }
        type bfl_sovereign_debt_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/debt.dds" } }
        blockoverride "title_text" { text = "bfl_sovereign_debt_heading" }
        blockoverride "concept_link" { text = "bfl_sovereign_accounts_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 icon_pie = {
            visible = "[Not(IsDataModelEmpty(CreditLateralView.GetLoansTakenMerged))]"
            blockoverride "PieSize" { size = { 80 80 } }
            blockoverride "scrollarea_pie_size" { using = layoutpolicy_expanding size = { 300 -1 } maximumsize = { 300 250 } }
            blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
            blockoverride "Icon" { texture = "[GetConceptTexture('borrower')]" }
            blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
            blockoverride "SliceColor" { color = "[LoanEntry.GetColor]" }
            blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetShortNameAsBorrower]" }
            blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
            blockoverride "color" { color = "[LoanEntry.GetColor]" }
            blockoverride "leftside_info" { text = "[LoanEntry.GetShortNameAsBorrower]" }
            blockoverride "rightside_info" { raw_text = "[LoanEntry.GetAmountWithRemainingInterest]" } }
            TooltipTextBlock = { visible = "[IsDataModelEmpty(CreditLateralView.GetLoansTakenMerged)]"
                blockoverride "text" { text = "NO_LOANS_TAKEN" } } } }
    }type bfl_sovereign_receivables_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/debt.dds" } }
        blockoverride "title_text" { text = "bfl_sovereign_receivables_heading" }
        blockoverride "concept_link" { text = "bfl_sovereign_accounts_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 icon_pie = {
            visible = "[Not(IsDataModelEmpty(CreditLateralView.GetLoansGivenMerged))]"
            blockoverride "PieSize" { size = { 80 80 } }
            blockoverride "scrollarea_pie_size" { using = layoutpolicy_expanding size = { 300 -1 } maximumsize = { 300 250 } }
            blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
            blockoverride "Icon" { texture = "[GetConceptTexture('lender')]" }
            blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
            blockoverride "SliceColor" { color = "[LoanEntry.GetBorrowerColor]" }
            blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
            blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
            blockoverride "color" { color = "[LoanEntry.GetBorrowerColor]" }
            blockoverride "leftside_info" { text = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
            blockoverride "rightside_info" { raw_text = "[LoanEntry.GetAmount|2]@gold!" } }
            TooltipTextBlock = { visible = "[IsDataModelEmpty(CreditLateralView.GetLoansGivenMerged)]"
                blockoverride "text" { text = "NO_LOANS_GIVEN" } } } }
    }
        type bfl_bank_overview = vbox { layoutpolicy_horizontal = expanding spacing = 4 vbox = { layoutpolicy_horizontal = expanding spacing = 8 margin = { 10 6 }
        hbox = { spacing = 8 icon = { texture = "gfx/interface/icons/bfl/accounts.dds" size = { 32 32 } } vbox = { layoutpolicy_horizontal = expanding tooltip = "bfl_bank_identity_tip" text_single = { raw_text = "[Country.GetName]" size = { -1 22 } layoutpolicy_horizontal = expanding } text_single = { text = "bfl_profile_0" autoresize = yes visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_profile').GetValue, '(CFixedPoint)0')]" }text_single = { text = "bfl_profile_1" autoresize = yes visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_profile').GetValue, '(CFixedPoint)1')]" }text_single = { text = "bfl_profile_2" autoresize = yes visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_profile').GetValue, '(CFixedPoint)2')]" } }
