        hbox = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed size = { -1 30 } spacing = 10
            hbox = { spacing = 4 tooltipwidget = { bfl_monthly_statement_tooltip = { } }
                icon = { texture = "gfx/interface/icons/bfl/accounts.dds" size = { 18 18 } } text_single = { text = "bfl_activity_title" autoresize = yes fontsize = 12 }
                text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_report_net_income')|2+=]@gold!" autoresize = yes fontsize = 14 } }
            expand = { }
            hbox = { spacing = 4 tooltipwidget = { bfl_operating_cost_tooltip = { } }
                text_single = { text = "bfl_operating_costs" autoresize = yes fontsize = 12 }
                text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_operating_expense')|2]@gold!" autoresize = yes fontsize = 14 } } } } hbox = { name = "bfl_sovereign_accounts_row" layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = fixed size = { -1 46 } margin = { 10 0 } spacing = 8 datacontext = "[GetPlayer]"
        vbox = { layoutpolicy_horizontal = expanding spacing = 1 tooltipwidget = { bfl_sovereign_debt_tooltip = { } }
            text_single = { text = "bfl_sovereign_debt" autoresize = yes fontsize = 12 }
            text_single = { raw_text = "[GetPlayer.GetEconomy.GetTotalDebt|2]@gold!" autoresize = yes fontsize = 12 } }
        hbox = { name = "bfl_native_credit_tools" layoutpolicy_vertical = fixed size = { 80 36 } spacing = 8
        button_regular = { name = "bfl_repay_all" size = { 36 36 } using = repay_all_loans_action_provider
            tooltip = "REPAY_ALL_LOANS_TITLE"
            icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/redeem.dds" } }
        button_regular = { name = "bfl_bankruptcy" size = { 36 36 } using = declare_bankruptcy_action_provider
            tooltip = "DECLARE_BANKRUPTCY"
            icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/flat_icons/military/bankruptcy.dds" } }
    }
        vbox = { layoutpolicy_horizontal = expanding spacing = 1 tooltipwidget = { bfl_sovereign_receivables_tooltip = { } }
            text_single = { text = "bfl_sovereign_receivables" autoresize = yes align = right|nobaseline fontsize = 12 }
            text_single = { raw_text = "[CreditLateralView.GetTotalLoansGiven|2]@gold!" autoresize = yes align = right|nobaseline fontsize = 12 } }
    } }
        type bfl_credit_overview = widget { size = { -1 300 } layoutpolicy_horizontal = expanding using = bg_age_event_frame
            background = { texture = "gfx/interface/illustrations/institutions/banking.dds" fittype = centercrop alpha = 0.65 }
            bfl_bank_overview = { datacontext = "[GetPlayer]"
        visible = "[GetScriptedGui('bfl_independent_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        bfl_bank_overview = { datacontext = "[GetPlayer.MakeScope.GetVariable('bfl_bank').GetCountry]"
        visible = "[GetScriptedGui('bfl_charter_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        }
        type bfl_credit_funding_body = scrollarea {
            size = { -1 0 } minimumsize = { 0 0 } using = layoutpolicy_expanding
            scrollbarpolicy_horizontal = always_off scrollbar_vertical = { using = Scrollbar_Vertical }
            scrollwidget = { vbox = { ignoreinvisible = yes layoutpolicy_horizontal = expanding margin = { 5 5 } spacing = 5 hbox = { layoutpolicy_horizontal = expanding layoutpolicy_vertical = fixed size = { -1 38 } spacing = 6 button_secondary_tab_alt = { layoutpolicy_horizontal = expanding tooltip = "bfl_bonds_short_tip"
            blockoverride "tab_text" { text = "bfl_bonds_short" } down = "[Not(CreditLateralView.Vars.HasValue('funding_section','deposits'))]"
            onclick = "[CreditLateralView.Vars.Set('funding_section','bonds')]" }button_secondary_tab_alt = { layoutpolicy_horizontal = expanding tooltip = "bfl_funding_title_tip"
            blockoverride "tab_text" { text = "bfl_funding_title" } down = "[CreditLateralView.Vars.HasValue('funding_section','deposits')]"
            onclick = "[CreditLateralView.Vars.Set('funding_section','deposits')]" } }vbox = { ignoreinvisible = yes layoutpolicy_vertical = fixed layoutpolicy_horizontal = expanding visible = "[Not(CreditLateralView.Vars.HasValue('funding_section','deposits'))]" bfl_bond_contents = { } }vbox = { layoutpolicy_vertical = fixed layoutpolicy_horizontal = expanding spacing = 6
