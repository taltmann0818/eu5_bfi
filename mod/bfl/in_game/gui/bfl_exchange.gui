        }
                type bfl_buy_quantity_widget = widget { size = { -1 118 } layoutpolicy_horizontal = expanding
            datacontext = "[SelectInteractionTargetView.GetValueGlue('share_quantity')]"
            using = bg_paper_card
            text_single = { position = { 15 8 } text = "bfl_share_quantity" autoresize = yes fontsize = 16 }
            text_single = { position = { 15 32 } text = "[SelectInteractionTargetGlue.GetValue|3]" autoresize = yes fontsize = 20 }
            economy_slider = { visible = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid]" position = { 15 72 } size = { 315 10 }
                min = "[Min_float('(float)1',FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_buy_selection_max')))]" max = "[FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_buy_selection_max'))]"
                step = "[SelectInteractionTargetGlue.GetStep]" value = "[SelectInteractionTargetGlue.GetValue]"
                onvaluechanged = "[SelectInteractionTargetGlue.OnValueChanged]" }
            button_regular = { position = { 350 45 } size = { 160 40 } text = "bfl_review_trade"
                enabled = "[And(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid,GreaterThan_CFixedPoint(SelectInteractionTargetGlue.GetValue,'(CFixedPoint)0'))]" tooltip = "bfl_review_trade_tip"
                onclick = "[SelectInteractionTargetView.Confirm]" }
        }
        type bfl_sell_quantity_widget = widget { size = { -1 118 } layoutpolicy_horizontal = expanding
            datacontext = "[SelectInteractionTargetView.GetValueGlue('share_quantity')]"
            using = bg_paper_card
            text_single = { position = { 15 8 } text = "bfl_share_quantity" autoresize = yes fontsize = 16 }
            text_single = { position = { 15 32 } text = "[SelectInteractionTargetGlue.GetValue|3]" autoresize = yes fontsize = 20 }
            economy_slider = { visible = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid]" position = { 15 72 } size = { 315 10 }
                min = "[Min_float('(float)1',FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_sell_selection_max')))]" max = "[FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_sell_selection_max'))]"
                step = "[SelectInteractionTargetGlue.GetStep]" value = "[SelectInteractionTargetGlue.GetValue]"
                onvaluechanged = "[SelectInteractionTargetGlue.OnValueChanged]" }
            button_regular = { position = { 350 45 } size = { 160 40 } text = "bfl_review_trade"
                enabled = "[And(And(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid,GreaterThan_CFixedPoint(SelectInteractionTargetGlue.GetValue,'(CFixedPoint)0')),GreaterThanOrEqualTo_CFixedPoint(Multiply_CFixedPoint(SelectInteractionTargetGlue.GetValue,GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_sell_selection_price')),'(CFixedPoint)0.005'))]" tooltip = "bfl_review_trade_tip"
                onclick = "[SelectInteractionTargetView.Confirm]" }
        }

        type bfl_equity_investments = vbox { layoutpolicy_horizontal = expanding spacing = 8
            hbox = { layoutpolicy_horizontal = expanding spacing = 10 button_regular = { size = { -1 64 } layoutpolicy_horizontal = expanding
            datacontext = "[GetGenericAction('bfl_buy_shares')]" enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_buy_shares_tip"
            scripted_action_tooltip = { click_type = left click_mode = single action_name = "bfl_buy_shares" actor = "[GetPlayer]" }
            icon = { position = { 8 6 } size = { 52 52 } texture = "gfx/interface/icons/bfl/buy_shares.dds" }
            text_single = { position = { 66 21 } text = "bfl_buy_shares" autoresize = yes fontsize = 19 }
        }button_regular = { size = { -1 64 } layoutpolicy_horizontal = expanding
            datacontext = "[GetGenericAction('bfl_sell_shares')]" enabled = "[PdxGuiWidget.IsUberButtonEnabled]" tooltip = "bfl_sell_shares_tip"
            scripted_action_tooltip = { click_type = left click_mode = single action_name = "bfl_sell_shares" actor = "[GetPlayer]" }
            icon = { position = { 8 6 } size = { 52 52 } texture = "gfx/interface/icons/bfl/sell_shares.dds" }
            text_single = { position = { 66 21 } text = "bfl_sell_shares" autoresize = yes fontsize = 19 }
        } }
            widget = { size = { -1 74 } layoutpolicy_horizontal = expanding using = bg_card_header_01
            datacontext = "[GetPlayer]" visible = "[GetScriptedGui('bfl_independent_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            tooltipwidget = { bfl_share_portfolio_tooltip = { } }
            icon = { position = { 10 14 } size = { 40 40 } texture = "gfx/interface/icons/bfl/share_transfer.dds" }
            text_single = { position = { 60 8 } text = "bfl_share_value_label" autoresize = yes fontsize = 15 }
            text_single = { position = { 60 30 } raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_portfolio_market')|2]@gold!  [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_portfolio_return')|%1+=]" autoresize = yes fontsize = 21 }
            text_single = { position = { 60 57 } text = "bfl_share_portfolio_hint" autoresize = yes fontsize = 11 }
        }widget = { size = { -1 74 } layoutpolicy_horizontal = expanding using = bg_card_header_01
            datacontext = "[GetPlayer]" visible = "[GetScriptedGui('bfl_charter_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            tooltipwidget = { bfl_share_portfolio_tooltip = { } }
            icon = { position = { 10 14 } size = { 40 40 } texture = "gfx/interface/icons/bfl/share_transfer.dds" }
            text_single = { position = { 60 8 } text = "bfl_share_value_label" autoresize = yes fontsize = 15 }
            text_single = { position = { 60 30 } raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_portfolio_market')|2]@gold!  [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_portfolio_return')|%1+=]" autoresize = yes fontsize = 21 }
            text_single = { position = { 60 57 } text = "bfl_share_portfolio_hint" autoresize = yes fontsize = 11 }
        }
            button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_new_capital_subscription"
                datacontext = "[GetGenericAction('bfl_new_capital_subscription')]" tooltip = "bfl_new_capital_subscription_tip"
                enabled = "[PdxGuiWidget.IsUberButtonEnabled]" scripted_action_tooltip = { click_type = left click_mode = single action_name = "bfl_new_capital_subscription" actor = "[GetPlayer]" } }
            button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_manage_shareholdings"
                datacontext = "[GetGenericAction('bfl_manage_shareholdings')]" tooltip = "bfl_manage_shareholdings_desc"
                enabled = "[PdxGuiWidget.IsUberButtonEnabled]" scripted_action_tooltip = { click_type = left click_mode = single action_name = "bfl_manage_shareholdings" actor = "[GetPlayer]" } }
