            size = { 8 2 } visible = "[GreaterThan_CFixedPoint(Country.MakeScope.GetVariable('bfl_quote_09_period').GetValue,'(CFixedPoint)0')]" background = { texture = "gfx/interface/colors/white.dds" color = { 0.45 0.80 0.69 1 } } }widget = { position = "[ToVector2f('(float)24',FixedPointToFloat(GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_market_top_09')))]"
