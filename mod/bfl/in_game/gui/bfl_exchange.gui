                type bfl_buy_quantity_widget = widget { size = { -1 118 } layoutpolicy_horizontal = expanding
            datacontext = "[SelectInteractionTargetView.GetValueGlue('share_quantity')]"
            using = bg_paper_card
            text_single = { position = { 15 8 } text = "bfl_share_quantity" autoresize = yes fontsize = 16 }
            text_single = { position = { 15 32 } text = "[SelectInteractionTargetGlue.GetValue|3]" autoresize = yes fontsize = 20 }
            economy_slider = { visible = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid]" position = { 15 72 } size = { 315 10 }
                min = "[Min_float('(float)1',FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_buy_selection_max')))]" max = "[FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_buy_selection_max'))]"
                step = "[SelectInteractionTargetGlue.GetStep]" value = "[SelectInteractionTargetGlue.GetValue]"
                onvaluechanged = "[SelectInteractionTargetGlue.OnValueChanged]" }
            button_regular = { position = { 350 45 } size = { 36 36 }
                enabled = "[And(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid,GreaterThan_CFixedPoint(SelectInteractionTargetGlue.GetValue,'(CFixedPoint)0'))]" tooltip = "bfl_review_trade_tip"
                onclick = "[SelectInteractionTargetView.Confirm]" icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/share_transfer.dds" } }
        }
        type bfl_sell_quantity_widget = widget { size = { -1 118 } layoutpolicy_horizontal = expanding
            datacontext = "[SelectInteractionTargetView.GetValueGlue('share_quantity')]"
            using = bg_paper_card
            text_single = { position = { 15 8 } text = "bfl_share_quantity" autoresize = yes fontsize = 16 }
            text_single = { position = { 15 32 } text = "[SelectInteractionTargetGlue.GetValue|3]" autoresize = yes fontsize = 20 }
            economy_slider = { visible = "[SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid]" position = { 15 72 } size = { 315 10 }
                min = "[Min_float('(float)1',FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_sell_selection_max')))]" max = "[FixedPointToFloat(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('actor',GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_sell_selection_max'))]"
                step = "[SelectInteractionTargetGlue.GetStep]" value = "[SelectInteractionTargetGlue.GetValue]"
                onvaluechanged = "[SelectInteractionTargetGlue.OnValueChanged]" }
            button_regular = { position = { 350 45 } size = { 36 36 }
                enabled = "[And(And(SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.IsValid,GreaterThan_CFixedPoint(SelectInteractionTargetGlue.GetValue,'(CFixedPoint)0')),GreaterThanOrEqualTo_CFixedPoint(Multiply_CFixedPoint(SelectInteractionTargetGlue.GetValue,GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('security',SelectInteractionTargetView.GetCurrentParams.GetTargetObjectFromFlag('security').GetCountry.MakeScope).ScriptValue('bfl_market_sell_selection_price')),'(CFixedPoint)0.005'))]" tooltip = "bfl_review_trade_tip"
                onclick = "[SelectInteractionTargetView.Confirm]" icon = { parentanchor = center size = { 26 26 } texture = "gfx/interface/icons/bfl/share_transfer.dds" } }
        }

