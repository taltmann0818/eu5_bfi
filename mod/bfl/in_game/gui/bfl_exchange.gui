                background = { texture = "gfx/interface/colors/white.dds" color = { 0.45 0.80 0.69 1 } } }widget = { position = "[ToVector2f('(float)40',FixedPointToFloat(GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_market_y_07')))]"
