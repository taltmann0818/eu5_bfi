types BFLStrategyTypes {
        type bfl_strategy_contents = vbox { layoutpolicy_horizontal = expanding spacing = 4
            tooltip = "bfl_strategy_title_tip"
            widget = { size = { -1 30 } layoutpolicy_horizontal = expanding using = bg_card_header_01
                text_single = { parentanchor = center text = "bfl_strategy_title" autoresize = yes } }
            text_multi = { text = "bfl_strategy_automatic" autoresize = yes layoutpolicy_horizontal = expanding
                visible = "[LessThan_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_mode').GetValue, '(CFixedPoint)0')]" }
            text_multi = { text = "bfl_strategy_delegated" autoresize = yes layoutpolicy_horizontal = expanding
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_mode').GetValue, '(CFixedPoint)1')]" }
            text_multi = { text = "bfl_strategy_manual" autoresize = yes layoutpolicy_horizontal = expanding
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_mode').GetValue, '(CFixedPoint)0')]" }
            text_multi = { text = "bfl_strategy_statement" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12 }
            text_multi = { text = "bfl_strategy_idle" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12
        visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_action').GetValue, '(CFixedPoint)0')]" }
text_multi = { text = "bfl_strategy_credit" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12
        visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_action').GetValue, '(CFixedPoint)1')]" }
text_multi = { text = "bfl_strategy_deposit" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12
        visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_action').GetValue, '(CFixedPoint)2')]" }
text_multi = { text = "bfl_strategy_recall" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12
        visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_strategy_action').GetValue, '(CFixedPoint)3')]" }
            hbox = { layoutpolicy_horizontal = expanding spacing = 6
                button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding
            text = "bfl_strategy_enable" tooltip = "bfl_strategy_enable_tip"
            enabled = "[GetScriptedGui('bfl_strategy_enable').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_strategy_enable').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding
            text = "bfl_strategy_disable" tooltip = "bfl_strategy_disable_tip"
            enabled = "[GetScriptedGui('bfl_strategy_disable').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('bfl_strategy_disable').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } }
        }
    }
