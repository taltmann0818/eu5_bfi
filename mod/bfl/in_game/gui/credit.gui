								# 				blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
								# 				blockoverride "SliceColor" { color = "[LoanEntry.GetColor]" }
								# 				blockoverride "Icon" { texture = "[GetConceptTexture('borrower')]" }
								# 				blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansTakenMerged]" }
								# 				blockoverride "item_bg_color" { using = color_light_paper_texture alpha = 0.1 }
								# 				blockoverride "color" { color = "[LoanEntry.GetColor]" }
								# 				blockoverride "leftside_info" { text = "[LoanEntry.GetShortNameAsBorrower]" }
								# 				blockoverride "rightside_info" { text = "[LoanEntry.GetAmount|2][gold_i]" }
								# 			}
								# 		}
								# 	}
								# }
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "LOANS_TAKEN_TITLE"
								default_format = "#explanation_link"
								autoresize = yes
								align = left|nobaseline
							}
							text_single = {
								layoutpolicy_horizontal = expanding
								raw_text = "[Player.GetEconomy.GetTotalDebt|2V][gold_i] (#R [CreditLateralView.GetTotalLoansTakenMonthlyCost|2]#!@expense!)"
								autoresize = yes
								align = left|nobaseline
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetConceptTexture('lender')]"
										glow = {
											name = "drop_shadow"
											glow_radius = 3
											color = { 0.0 0.0 0.0 1.0 }
											alpha = 0.3
										}
									}
								}
								blockoverride "concept_link" {
									text = [loan|e]
								}

								blockoverride "title_text" { text = "LOANS_GIVEN_TITLE" }
								blockoverride "description_text" {}
								blockoverride "tooltip_content" {
									icon_pie = {
										visible = "[Not(IsDataModelEmpty(CreditLateralView.GetLoansGivenMerged))]"
										blockoverride "PieSize" { size = { 120 120 } }
										blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
										blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
										blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
										blockoverride "SliceColor" { color = "[LoanEntry.GetBorrowerColor]" }
										blockoverride "Icon" { texture = "[GetConceptTexture('lender')]" }
										blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
										blockoverride "item_bg_color" { using = color_light_paper_texture alpha = 0.1 }
										blockoverride "color" { color = "[LoanEntry.GetBorrowerColor]" }
										blockoverride "leftside_info" { text = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
										blockoverride "rightside_info" { text = "[LoanEntry.GetAmount|2][gold_i]" }
									}
									TooltipTextBlock = {
										visible = "[IsDataModelEmpty(CreditLateralView.GetLoansGivenMerged)]"
										blockoverride "text" { text = "NO_LOANS_GIVEN" }
									}
								}
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 4

							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = yes
								text = "LOANS_GIVEN_TITLE"
								default_format = "#explanation_link"
								align = right|nobaseline
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = yes
								raw_text = "[CreditLateralView.GetTotalLoansGiven|2V]@gold! ([CreditLateralView.GetTotalLoansGivenMonthlyCost|2+=]@income!)"
								align = right|nobaseline
							}
						}

						icon_pie_left = {
							using = bg_circle_piechart_big
							blockoverride "PieSize" { size = { 40 40 } }
							blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansGiven]" }
							blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
							blockoverride "SliceColor" { color = "[LoanEntry.GetBorrowerColor]" }
							blockoverride "Icon" { texture = "[GetConceptTexture('lender')]" }
							blockoverride "SliceTooltip" {
								# tooltipwidget = {
								# 	ContextualTooltipType = {
								# 		blockoverride "title_icon" {
								# 			icon = {
								# 				using = tooltip_title_icon_size
								# 				texture = "[GetConceptTexture('lender')]"
								# 				glow = {
								# 					name = "drop_shadow"
								# 					glow_radius = 3
								# 					color = { 0.0 0.0 0.0 1.0 }
								# 					alpha = 0.3
								# 				}
								# 			}
								# 		}
								# 		blockoverride "title_text" { text = "LOANS_GIVEN_TITLE" }
								# 		blockoverride "description_text" {}
								# 		blockoverride "tooltip_content" {
								# 			icon_pie = {
								# 				blockoverride "PieSize" { size = { 120 120 } }
								# 				blockoverride "pie_datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
								# 				blockoverride "SliceTooltip" { tooltip = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
								# 				blockoverride "SliceValue" { value = "[LoanEntry.GetAmount]" }
								# 				blockoverride "SliceColor" { color = "[LoanEntry.GetColor]" }
								# 				blockoverride "Icon" { texture = "[GetConceptTexture('lender')]" }
								# 				blockoverride "datamodel" { datamodel = "[CreditLateralView.GetLoansGivenMerged]" }
								# 				blockoverride "item_bg_color" { using = color_light_paper_texture alpha = 0.1 }
								# 				blockoverride "color" { color = "[LoanEntry.GetColor]" }
								# 				blockoverride "leftside_info" { text = "[LoanEntry.GetLoan.GetShortNameAsLender]" }
								# 				blockoverride "rightside_info" { text = "[LoanEntry.GetAmount|2][gold_i]" }
								# 			}
								# 		}
								# 	}
								# }
							}
						}
					}
				}
			}

			widget = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				size = { -1 220 }
 visible = "[Not(GetScriptedGui('bfl_permission_demand_deposit').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"

				background = {
					texture = "gfx/interface/illustrations/institutions/banking.dds"
					fittype = centercrop
				}

				using = bg_age_event_frame
				hbox = {
					ecs_scene_viewer_widget =  {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						name = "balance_overview_scene"
						scene = "[Player.GenerateSceneDesc('balance')]"
						alpha = 0.7	
						using = scene_fade_horizontal
						blockoverride "scene_fade_alpha" {
							alpha = 0.8
						}
					}
	
				}


				widget = {
					parentanchor = center
					size = { 100% 40 }
					visible = "[GetPlayer.GetEconomy.IsDuringBankruptcy]"

					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_text" {
								text = "IN_BANKRUPTCY"
							}
							blockoverride "title_icon_texture" {
								texture = "[GetConceptTexture('bankrupt')]"
							}
							blockoverride "concept_link" {
								text = [bankrupt|e]
							}
							blockoverride "tooltip_content" {
								datacontext = "[GetPlayer]"
								TooltipStringPairList = {
									blockoverride "block_title" { text = "BANKRUPTCY_UNTIL" }
									textcontext = "[ShowModifierEffect('is_bankrupt')]"
								}
							}
						}
					}

					background = {
						texture = "gfx/interface/colors/black.dds"
						alpha = 1
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_horizontal_middle.dds"
							blend_mode = alphamultiply
						}
					}

					background = {
						texture = "gfx/interface/colors/red.dds"
						alpha = 0.5
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_horizontal_middle.dds"
							blend_mode = alphamultiply
						}
					}

					hbox = {
						spacing = 5

						expand = {}
						piechart = {
							size = { 32 32 }
							using = piechart_angles
							using = bg_circle_alt_brown
							using = bg_circle_piechart

							icon = {
								texture = "[GetConceptTexture('bankrupt')]"
								size = { 60% 60% }
								parentanchor = center
							}

							pieslice_no_highlight = {
								alwaystransparent = yes
								texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
								value = "[GetPlayer.GetBankruptcyProgress]"
								color = { 1 1 1 1 }
							}

							pieslice_no_highlight = {
								alwaystransparent = yes
								texture = "gfx/interface/pie_charts/pie_chart_blue_progress.dds"
								value = "[Subtract_float('(float)1.0', GetPlayer.GetBankruptcyProgress)]"
								color = { 1 1 1 0 }
							}
						}

						text_single = {
							maximumsize = { 200 -1 }
							text = "IN_BANKRUPTCY"
							using = Font_Type_Headers
							using = Font_Size_Big
						}
						expand = {}
					}
				}

				hbox = {
					margin = { 8 0 }

					### Left: creditworthiness + debt breakdown
					vbox = {
						using = layoutpolicy_expanding

						icon_text_2rows = {
							blockoverride "icon_setup" {
								texture = "[GetConceptTexture('creditworthiness')]"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "top_text_setup" {
								text = "creditworthiness"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								raw_text = "[Multiply_CFixedPoint(Player.GetCreditworthiness, '(CFixedPoint)100')|0]"
							}
							datacontext = "[Player]"
							tooltipwidget = {
								using = CreditworthinessTooltip
							}
						}

						icon_text_2rows = {
							blockoverride "icon_setup" {
								texture = "gfx/interface/icons/flat_icons/balance/estates_loan.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "top_text_setup" {
								text = "DEBT_BREAKDOWN_ESTATES_LABEL"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								raw_text = "[Player.GetEconomy.GetEstateDebt|2V]@gold!"
							}
							tooltip = "[Player.GetEconomy.GetEstateDebtImpactDesc]"
							tagtooltip_enabled = yes
						}

						icon_text_2rows = {
							blockoverride "icon_setup" {
								texture = "gfx/interface/icons/flat_icons/balance/foreign_loan.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "top_text_setup" {
								text = "DEBT_BREAKDOWN_FOREIGN_LABEL"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								raw_text = "[Player.GetEconomy.GetForeignDebt|2V]@gold!"
							}
							tooltipmeta = {
								texture = "gfx/interface/icons/flat_icons/balance/estates_loan.dds"
							}
							tooltip = "[Player.GetEconomy.GetForeignDebtImpactDesc]"
							tagtooltip_enabled = yes
						}

						icon_text_2rows = {
							blockoverride "base_setup" {
								layoutstretchfactor_vertical = 1
							}
							blockoverride "icon_setup" {
								texture = "[GetConceptTexture('government_bond')]"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "top_text_setup" {
								text = "DEBT_BREAKDOWN_BONDS_LABEL"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								raw_text = "[Player.GetEconomy.GetBondDebt|2V]@gold!"
							}
							tooltip = "[Player.GetEconomy.GetBondDebtImpactDesc]"
							tagtooltip_enabled = yes
						}
					}

					### Right: stats
					vbox = {
						using = layoutpolicy_expanding
						
						icon_text_2rows = {
							blockoverride "base_setup" {
								righttoleft = yes
							}
							blockoverride "icon_setup" {
								texture = "gfx/interface/icons/flat_icons/balance/interest.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "text_align" {
								align = right|nobaseline
							}
							blockoverride "top_text_setup" {
								text = "MODIFIER_TYPE_NAME_bank_interest"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								text = "[Player.GetModifierValueNoFormat('bank_interest')]"
							}
							datacontext = "[Player]"
							tooltipwidget = {
								using = BankInterest_tooltip
							}
						}

						icon_text_2rows = {
							blockoverride "base_setup" {
								righttoleft = yes
								layoutstretchfactor_vertical = 1
							}
							blockoverride "icon_setup" {
								texture = "gfx/interface/icons/flat_icons/gold.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "text_align" {
								align = right|nobaseline
							}
							blockoverride "top_text_setup" {
								text = "BONDS_HEADER_SLOTS_LABEL"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								raw_text = "[Player.GetNumBonds] / [Player.GetDoubleModifierValue('max_bonds', 'max_bonds_modifier')|0]"
							}
						}

						icon_text_2rows = {
							blockoverride "base_setup" {
								righttoleft = yes
							}
							blockoverride "icon_setup" {
								texture = "gfx/interface/icons/flat_icons/balance/interest.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "text_align" {
								align = right|nobaseline
							}
							blockoverride "top_text_setup" {
								text = "BONDS_HEADER_INTEREST_LABEL"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								raw_text = "[Player.GetModifierValueNoFormat('bond_interest')|%-=]"
							}
							datacontext = "[Player]"
							tooltipwidget = {
								using = BondInterest_tooltip
							}
						}

						icon_text_2rows = {
							blockoverride "base_setup" {
								righttoleft = yes
								layoutstretchfactor_vertical = 1
							}
							blockoverride "icon_setup" {
								texture = "gfx/interface/icons/flat_icons/gold.dds"
								glow = {
									name = "drop_shadow"
									glow_radius = 3
									color = { 0.0 0.0 0.0 1.0 }
									alpha = 0.3
								}
							}
							blockoverride "text_align" {
								align = right|nobaseline
							}
							blockoverride "top_text_setup" {
								text = "BONDS_HEADER_SIZE_LABEL"
								default_format = "#explanation_link_overview"
							}
							blockoverride "bottom_text_setup" {
								text = "[Player.GetBondSizeText]"
							}
						}
					}
				}
			}
 bfl_credit_overview = { visible = "[GetScriptedGui('bfl_permission_demand_deposit').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }


			vbox = {
				using = layoutpolicy_expanding
                ignoreinvisible = yes
				header_secondary_tabs = {
					blockoverride "content" {
						button_secondary_tab_alt = {
							layoutpolicy_horizontal = expanding
							tooltip_enabled = no

							blockoverride "tab_text" {
								text = "bfl_funding_tab"
							}

							action_tooltip = {
								title = "OPEN_TAB"
								on_action = "[GetScriptedGui('bfl_prepare_bond_panel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
on_action = "[CreditLateralView.Vars.Set('subtab','loans_taken')]"
							}
							down = "[CreditLateralView.Vars.HasValue('subtab','loans_taken')]"
						}

						button_secondary_tab_alt = {
							layoutpolicy_horizontal = expanding
							tooltip_enabled = no

							blockoverride "tab_text" {
								text = "bfl_investment_tab"
							}

							action_tooltip = {
								title = "OPEN_TAB"
								on_action = "[CreditLateralView.Vars.Set('subtab','loans_given')]"
							}
							down = "[CreditLateralView.Vars.HasValue('subtab','loans_given')]"
						}
					}
				}

				# loans taken
				vbox = { using = layoutpolicy_expanding using = bg_secondary_inner_alt
            visible = "[CreditLateralView.Vars.HasValue('subtab','loans_taken')]"
            bfl_credit_funding = { name = "bfl_credit_funding" }
            text_single = { text = "bfl_no_bank_short" tooltip = "bfl_no_bank" autoresize = yes
                visible = "[Not(GetScriptedGui('bfl_permission_demand_deposit').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
        }

				# loans given
				vbox = { using = layoutpolicy_expanding using = bg_secondary_inner_alt
            visible = "[CreditLateralView.Vars.HasValue('subtab','loans_given')]"
            bfl_credit_investment = { name = "bfl_credit_investment" }
            text_single = { text = "bfl_no_bank_short" tooltip = "bfl_no_bank" autoresize = yes
                visible = "[Not(GetScriptedGui('bfl_permission_demand_deposit').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" }
        }
			}
		}
	}
}
