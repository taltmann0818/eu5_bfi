types BFLResolutionTypes { type bfl_resolution_contents = vbox { layoutpolicy_horizontal = expanding spacing = 4 vbox = { layoutpolicy_horizontal = expanding spacing = 4 tooltip = "bfl_resolution_heading_tip"
        widget = { size = { -1 30 } layoutpolicy_horizontal = expanding using = bg_card_header_01
             text_single = { parentanchor = center text = "bfl_resolution_heading" autoresize = yes } } text_multi = { text = "bfl_resolution_help" autoresize = yes layoutpolicy_horizontal = expanding }text_single = { raw_text = "Available recovery cash: [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_resolution_available')|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Reserved for other claims: [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_resolution_other_reserves')|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Deposit recoveries paid: [Country.MakeScope.GetVariable('bfl_resolution_paid').GetValue|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Accepted losses: [Country.MakeScope.GetVariable('bfl_resolution_waived').GetValue|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Converted to equity: [Country.MakeScope.GetVariable('bfl_resolution_converted').GetValue|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Public guarantee paid: [Country.MakeScope.GetVariable('bfl_resolution_guarantee_paid').GetValue|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Guarantee awaiting funding: [Country.MakeScope.GetVariable('bfl_resolution_guarantee_due').GetValue|2]@gold!" size = { -1 22 } layoutpolicy_horizontal = expanding }text_single = { raw_text = "Selected deposit account: [Country.MakeScope.GetVariable('bfl_resolution_selected').GetValue|0] · claim [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_resolution_selected_claim')|2]@gold!" size = { -1 24 } layoutpolicy_horizontal = expanding }hbox = { layoutpolicy_horizontal = expanding spacing = 4 button_regular = { name = "bfl_resolution_begin_command_button" size = { -1 32 } layoutpolicy_horizontal = expanding
        tooltip = "bfl_resolution_begin_command_tip" text = "bfl_resolution_begin_command"
        enabled = "[GetScriptedGui('bfl_resolution_begin_command').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        onclick = "[GetScriptedGui('bfl_resolution_begin_command').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }button_regular = { name = "bfl_resolution_pay_command_button" size = { -1 32 } layoutpolicy_horizontal = expanding
