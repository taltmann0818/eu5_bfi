            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 TooltipTextBlock = { blockoverride "text" { text = "bfl_report_services_definition" } }TooltipListScrollArea = {
        blockoverride "block_scrollarea" { minimumsize = { 420 0 } maximumsize = { 420 300 } }
