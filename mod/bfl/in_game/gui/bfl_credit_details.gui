types BFLCreditDetails { type bfl_report_credit_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/accounts.dds" } }
        blockoverride "title_text" { text = "bfl_report_credit_title" }
        blockoverride "concept_link" { text = "bfl_report_detail" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 TooltipTextBlock = { blockoverride "text" { text = "bfl_report_credit_definition" } }TooltipListScrollArea = {
        blockoverride "block_scrollarea" { minimumsize = { 420 0 } maximumsize = { 420 300 } }
        blockoverride "scrollarea_content" { TooltipContentSection = {
