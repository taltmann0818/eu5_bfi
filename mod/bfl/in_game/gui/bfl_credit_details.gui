        blockoverride "concept_link" { text = "bfl_report_detail" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 TooltipTextBlock = { blockoverride "text" { text = "bfl_report_goods_definition" } }TooltipListScrollArea = {
        blockoverride "block_scrollarea" { minimumsize = { 420 0 } maximumsize = { 420 300 } }
        blockoverride "scrollarea_content" { TooltipContentSection = {
            size = { 420 0 } minimumsize = { 420 0 } layoutpolicy_horizontal = fixed set_parent_dimension_to_minimum = height spacing = 0 widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Recorded bank earnings" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_statement_goods').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } } } } } } }
