types BFLBankChartTooltips {
type bfl_asset_cash_tooltip = ContextualTooltipTypeBase { vbox = { set_parent_size_to_minimum = yes margin = { 12 10 } spacing = 6
            text_single = { text = "bfl_asset_cash_summary" autoresize = yes }
            scrollarea = { size = { 350 0 } maximumsize = { 350 250 } autoresizescrollarea = yes autoresizeviewport = yes scrollbarpolicy_horizontal = always_off
                scrollbar_vertical = { using = Scrollbar_Vertical_Tooltips } scrollwidget = { vbox = { set_parent_dimension_to_minimum = height ignoreinvisible = yes layoutpolicy_vertical = shrinking spacing = 4 text_single = { raw_text = "[Country.GetName]: [Country.GetFixedPointCurrencyValue('gold')|2]@gold!" autoresize = yes } } } } } }
