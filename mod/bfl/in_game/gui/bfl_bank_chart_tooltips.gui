                    size = { -1 24 } layoutpolicy_vertical = fixed layoutpolicy_horizontal = expanding spacing = 15
                    text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_asset_01_party').GetCountry.GetName]" autoresize = yes }
