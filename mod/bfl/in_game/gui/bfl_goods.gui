                tooltip = "bfl_goods_set_allocation_tip" }button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_goods_policy_allocation_25"
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_goods_allocation').GetValue,'(CFixedPoint)25')]"
                enabled = "[GetScriptedGui('bfl_goods_set_allocation').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
