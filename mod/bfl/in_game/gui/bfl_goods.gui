    } type bfl_goods_contents = vbox { layoutpolicy_horizontal = expanding spacing = 4 widget = { size = { -1 80 } layoutpolicy_horizontal = expanding using = bg_card_header_01
        icon = { position = { 8 15 } size = { 46 46 } texture = "gfx/interface/icons/bfl/goods_inventory.dds" }
        widget = { position = { 60 4 } size = { 300 70 } tooltipwidget = { bfl_goods_inventory_tooltip = { } }
            text_single = { position = { 0 0 } text = "bfl_goods_inventory_title" autoresize = yes fontsize = 15 }
            text_single = { position = { 0 23 } raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_goods_market_value')|2]@gold!  [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_goods_portfolio_return')|%1+=]" autoresize = yes fontsize = 21 }
            text_single = { position = { 0 52 } text = "bfl_goods_inventory_hint" autoresize = yes fontsize = 11
                visible = "[GetScriptedGui('bfl_permission_commodity_inventory').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            text_single = { position = { 0 52 } text = "bfl_goods_trading_locked" autoresize = yes fontsize = 11 tooltip = "bfl_commodity_inventory_tip"
                visible = "[Not(GetScriptedGui('bfl_permission_commodity_inventory').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]" } }
        button_regular = { parentanchor = top|right position = { -8 10 } size = { 62 56 }
            tooltip = "bfl_goods_settings_tip" onclick = "[GetScriptedGui('bfl_goods_settings').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            icon = { parentanchor = top|hcenter position = { 0 1 } size = { 38 38 } texture = "gfx/interface/icons/bfl/goods_policy.dds" }
            text_single = { parentanchor = bottom|hcenter position = { 0 -2 } text = "bfl_goods_policy_button" autoresize = yes fontsize = 11 } } }
        vbox = { layoutpolicy_horizontal = expanding spacing = 3 ignoreinvisible = yes
            visible = "[GetScriptedGui('bfl_goods_policy_view').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
            text_single = { text = "bfl_goods_settings" autoresize = yes fontsize = 16 }
            hbox = { layoutpolicy_horizontal = expanding spacing = 5 vbox = { layoutpolicy_horizontal = expanding ignoreinvisible = yes button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_goods_policy_mandate_0"
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_goods_mandate').GetValue,'(CFixedPoint)0')]"
                enabled = "[GetScriptedGui('bfl_goods_set_mandate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('bfl_goods_set_mandate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = "bfl_goods_set_mandate_tip" }button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_goods_policy_mandate_1"
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_goods_mandate').GetValue,'(CFixedPoint)1')]"
                enabled = "[GetScriptedGui('bfl_goods_set_mandate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('bfl_goods_set_mandate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = "bfl_goods_set_mandate_tip" }button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_goods_policy_mandate_2"
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_goods_mandate').GetValue,'(CFixedPoint)2')]"
                enabled = "[GetScriptedGui('bfl_goods_set_mandate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('bfl_goods_set_mandate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = "bfl_goods_set_mandate_tip" } } vbox = { layoutpolicy_horizontal = expanding ignoreinvisible = yes button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_goods_policy_allocation_0"
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_goods_allocation').GetValue,'(CFixedPoint)0')]"
                enabled = "[GetScriptedGui('bfl_goods_set_allocation').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetScriptedGui('bfl_goods_set_allocation').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = "bfl_goods_set_allocation_tip" }button_regular = { size = { -1 30 } layoutpolicy_horizontal = expanding text = "bfl_goods_policy_allocation_10"
                visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_goods_allocation').GetValue,'(CFixedPoint)10')]"
                enabled = "[GetScriptedGui('bfl_goods_set_allocation').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
