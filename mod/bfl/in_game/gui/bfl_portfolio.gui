types BFLPortfolioTypes {
type bfl_security_financial_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/share_transfer.dds" } }
        blockoverride "title_text" { text = "bfl_security_financial_title" }
        blockoverride "concept_link" { text = "bfl_security_financial_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 TooltipListBase = {
        blockoverride "block_title" { visible = yes text = "bfl_security_price_heading" }
        widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "NAV per share" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_equity_quote')|3]@gold!" autoresize = yes align = right|nobaseline } } }widget = { visible = "[GetScriptedGui('bfl_portfolio_has_reference').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Previous recorded month" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_issuer_price_change')|%1+=]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Issued shares" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_total_units').GetValue|3]" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Last traded price" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_equity_last_price').GetValue|3]@gold!" autoresize = yes align = right|nobaseline } } } }TooltipListBase = {
        blockoverride "block_title" { visible = yes text = "bfl_security_financial_heading" }
        widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Treasury cash" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_issuer_cash')|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Loan and bond assets" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_issuer_credit')|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Goods and ventures" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_issuer_productive_assets')|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Liabilities" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_issuer_liabilities')|2]@gold!" autoresize = yes align = right|nobaseline } } }widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Tangible net assets" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_tangible_equity')|2]@gold!" autoresize = yes align = right|nobaseline } } } }TooltipListBase = { visible = "[GetScriptedGui('bfl_portfolio_bank_financials').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
        blockoverride "block_title" { visible = yes text = "bfl_security_bank_results" }
        widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Net income" autoresize = yes } expand = { }
