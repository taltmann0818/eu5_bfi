            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_issuer_last_costs')|2]@gold!" autoresize = yes align = right|nobaseline } } } }TooltipFlavorTextBlock = { blockoverride "text" { text = "bfl_security_price_math" } }TooltipFlavorTextBlock = { blockoverride "text" { text = "bfl_security_primary_note" } } } }
    }type bfl_share_portfolio_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/share_transfer.dds" } }
        blockoverride "title_text" { text = "bfl_share_portfolio_title" }
        blockoverride "concept_link" { text = "bfl_share_portfolio_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 TooltipListBase = {
        blockoverride "block_title" { visible = yes text = "bfl_portfolio_total_heading" }
        widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Value / unrealized" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_portfolio_market')|2]@gold! · [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_portfolio_return')|%1+=]" autoresize = yes align = right|nobaseline } } } }TooltipListBase = { visible = "[GetScriptedGui('bfl_treasury_portfolio_visible').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]"
        blockoverride "block_title" { visible = yes text = "bfl_portfolio_treasury_heading" }
        widget = { size = { -1 54 } layoutpolicy_horizontal = expanding visible = "[GetScriptedGui('bfl_treasury_portfolio_visible').IsShown(GuiScope.SetRoot(Country.MakeScope).End)]" background = { using = tooltip_table_field_texture }
            tooltipwidget = { bfl_security_financial_tooltip = { datacontext = "[GetPlayer.MakeScope.GetVariable('bfl_bank').GetCountry]" } }
            vbox = { position = { 10 3 } size = { 395 48 } spacing = 4 layoutpolicy_horizontal = expanding
            hbox = { size = { 395 22 } spacing = 8 layoutpolicy_horizontal = expanding
                icon = { size = { 14 22 } texture = "gfx/interface/component_tiles/bookmark_white.dds"
        color = "[GetPlayer.MakeScope.GetVariable('bfl_bank').GetCountry.GetMapColor]" }
                text_single = { raw_text = "[GetPlayer.MakeScope.GetVariable('bfl_bank').GetCountry.GetName]" autoresize = yes fontsize = 17 } expand = { }
                text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_treasury_portfolio_market')|2]@gold!" autoresize = yes fontsize = 17 } }
            hbox = { size = { 395 20 } layoutpolicy_horizontal = expanding margin_left = 22 text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_bank').GetCountry.MakeScope.GetVariable('bfl_state_units').GetValue|3] shares · basis [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_treasury_portfolio_basis')|2]@gold! · [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_treasury_portfolio_return')|%1+=]" autoresize = yes fontsize = 13 } } } } }vbox = { layoutpolicy_horizontal = expanding set_parent_dimension_to_minimum = height ignoreinvisible = yes
            datacontext = "[GetPlayer]" visible = "[GetScriptedGui('bfl_independent_view').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
