types BFLCommendaTypes { type bfl_venture_tooltip = ContextualTooltipType {
        blockoverride "title_icon" { icon = { using = tooltip_title_icon_size
            texture = "gfx/interface/icons/bfl/commenda_project.dds" } }
        blockoverride "title_text" { text = "bfl_venture_title" }
        blockoverride "concept_link" { text = "bfl_venture_subtitle" }
        blockoverride "tooltip_content" { vbox = { size = { 420 0 }
            set_parent_size_to_minimum = yes ignoreinvisible = yes spacing = 6 widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Active / capital at risk" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_venture_count')|0] / [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_venture_basis')|2]@gold!" autoresize = yes align = right|nobaseline } } }TooltipListScrollArea = {
        blockoverride "block_scrollarea" { maximumsize = { 420 360 } }
        blockoverride "scrollarea_content" { TooltipContentSection = {
            set_parent_dimension_to_minimum = height spacing = 0 vbox = { layoutpolicy_horizontal = expanding ignoreinvisible = yes visible = "[GreaterThan_CFixedPoint(Country.MakeScope.GetVariable('bfl_v_01_state').GetValue,'(CFixedPoint)0')]"
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_v_01_operator').GetCountry.GetName] · #1" autoresize = yes fontsize = 16 }
            widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Capital at risk" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_v_01_basis').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } }
            widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
        background = { using = tooltip_table_field_texture } hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Capital returned" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_v_01_returned').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } }
            widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Bank surplus share / remaining term" autoresize = yes } expand = { }
            text_single = { raw_text = "[GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_venture_share_01')|%0] / [GuiScope.SetRoot(Country.MakeScope).ScriptValue('bfl_venture_months_01')|0] months" autoresize = yes align = right|nobaseline } } }
            widget = {  size = { -1 30 } layoutpolicy_horizontal = expanding
         hbox = { layoutpolicy_horizontal = expanding margin = { 10 2 } spacing = 8
             text_single = { raw_text = "Realized profit / loss" autoresize = yes } expand = { }
            text_single = { raw_text = "[Country.MakeScope.GetVariable('bfl_v_01_profit').GetValue|2] / [Country.MakeScope.GetVariable('bfl_v_01_loss').GetValue|2]@gold!" autoresize = yes align = right|nobaseline } } }
            text_single = { text = "bfl_venture_state_1" autoresize = yes fontsize = 12 visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_v_01_state').GetValue,'(CFixedPoint)1')]" }text_single = { text = "bfl_venture_state_2" autoresize = yes fontsize = 12 visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_v_01_state').GetValue,'(CFixedPoint)2')]" }text_single = { text = "bfl_venture_state_3" autoresize = yes fontsize = 12 visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_v_01_state').GetValue,'(CFixedPoint)3')]" }
