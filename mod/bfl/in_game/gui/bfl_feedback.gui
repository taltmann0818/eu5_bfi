            visible = "[EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_facility_reason').GetValue, '(CFixedPoint)2')]" }text_multi = { text = "bfl_facility_reason_3" autoresize = yes layoutpolicy_horizontal = expanding fontsize = 12
