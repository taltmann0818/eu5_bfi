            duration = 0.3 alpha = 0.45 position_x = 8 next = bfl_feedback_rest  on_start = "[GetVariableSystem.Set(Concatenate('bfl_seen_', Country.GetTag), Localize('bfl_feedback_signature'))]" }state = { name = bfl_feedback_6 trigger_when = "[And3(Not(EqualTo_string(GetVariableSystem.Get(Concatenate('bfl_seen_', Country.GetTag)), Localize('bfl_feedback_signature'))), GetScriptedGui('bfl_motion_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_feedback_kind').GetValue, '(CFixedPoint)6'))]"
            duration = 0.3 alpha = 0.45 position_x = 8 next = bfl_feedback_rest  on_start = "[GetVariableSystem.Set(Concatenate('bfl_seen_', Country.GetTag), Localize('bfl_feedback_signature'))]" }state = { name = bfl_feedback_7 trigger_when = "[And3(Not(EqualTo_string(GetVariableSystem.Get(Concatenate('bfl_seen_', Country.GetTag)), Localize('bfl_feedback_signature'))), GetScriptedGui('bfl_motion_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_feedback_kind').GetValue, '(CFixedPoint)7'))]"
            duration = 0.3 alpha = 0.45 position_x = 0 next = bfl_feedback_rest  on_start = "[GetVariableSystem.Set(Concatenate('bfl_seen_', Country.GetTag), Localize('bfl_feedback_signature'))]" }state = { name = bfl_feedback_8 trigger_when = "[And3(Not(EqualTo_string(GetVariableSystem.Get(Concatenate('bfl_seen_', Country.GetTag)), Localize('bfl_feedback_signature'))), GetScriptedGui('bfl_motion_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_feedback_kind').GetValue, '(CFixedPoint)8'))]"
