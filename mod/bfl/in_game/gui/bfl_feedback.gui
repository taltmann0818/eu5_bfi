types BFLFeedbackTypes {
        type bfl_feedback = vbox { layoutpolicy_horizontal = expanding spacing = 2 tooltip = bfl_feedback_note
            visible = "[GreaterThan_CFixedPoint(Country.MakeScope.GetVariable('bfl_feedback_sequence').GetValue, '(CFixedPoint)0')]"
            state = { name = bfl_feedback_init trigger_on_create = yes  on_start = "[GetVariableSystem.Set(Concatenate('bfl_seen_', Country.GetTag), Localize('bfl_feedback_signature'))]" }
        state = { name = bfl_feedback_static trigger_when = "[And(Not(EqualTo_string(GetVariableSystem.Get(Concatenate('bfl_seen_', Country.GetTag)), Localize('bfl_feedback_signature'))), Not(GetScriptedGui('bfl_motion_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"  on_start = "[GetVariableSystem.Set(Concatenate('bfl_seen_', Country.GetTag), Localize('bfl_feedback_signature'))]" }state = { name = bfl_feedback_1 trigger_when = "[And3(Not(EqualTo_string(GetVariableSystem.Get(Concatenate('bfl_seen_', Country.GetTag)), Localize('bfl_feedback_signature'))), GetScriptedGui('bfl_motion_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_feedback_kind').GetValue, '(CFixedPoint)1'))]"
            duration = 0.6 alpha = 0.45 position_x = 8 next = bfl_feedback_rest  on_start = "[GetVariableSystem.Set(Concatenate('bfl_seen_', Country.GetTag), Localize('bfl_feedback_signature'))]" }state = { name = bfl_feedback_2 trigger_when = "[And3(Not(EqualTo_string(GetVariableSystem.Get(Concatenate('bfl_seen_', Country.GetTag)), Localize('bfl_feedback_signature'))), GetScriptedGui('bfl_motion_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), EqualTo_CFixedPoint(Country.MakeScope.GetVariable('bfl_feedback_kind').GetValue, '(CFixedPoint)2'))]"
